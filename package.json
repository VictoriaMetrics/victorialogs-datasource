{
  "name": "victoriametrics-logs-datasource",
  "version": "0.35.0",
  "description": "VictoriaLogs datasource plugin for grafana",
  "scripts": {
    "build": "webpack -c ./webpack.config.ts --env production",
    "dev": "webpack -w -c ./webpack.config.ts --env development",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "test:coverage": "jest --collectCoverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:server": "docker compose -f docker-compose.e2e.yaml up -d",
    "e2e:server:down": "docker compose -f docker-compose.e2e.yaml down",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ./tests",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "server": "docker compose up",
    "sign": "[ -z $GRAFANA_ACCESS_POLICY_TOKEN ] && echo 'skip plugin signing' || sign-plugin",
    "postinstall": "husky"
  },
  "author": "VictoriaMetrics",
  "license": "Apache-2.0",
  "devDependencies": {
    "@emotion/eslint-plugin": "11.12.0",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@grafana/e2e-selectors": "13.3.1",
    "@grafana/eslint-config": "10.0.0",
    "@grafana/plugin-e2e": "4.1.1",
    "@grafana/sign-plugin": "4.0.0",
    "@grafana/tsconfig": "2.2.0",
    "@playwright/test": "1.65.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@swc/core": "1.16.22",
    "@swc/helpers": "0.5.24",
    "@swc/jest": "0.2.39",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.27",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.5",
    "diagnostics-webpack-plugin": "1.1.4",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.17.1",
    "eslint-plugin-jsdoc": "65.5.3",
    "eslint-plugin-lodash": "8.1.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "fork-ts-checker-webpack-plugin": "9.2.0",
    "husky": "9.1.7",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "5.0.0",
    "intersection-observer": "0.12.2",
    "jest": "30.5.2",
    "jest-canvas-mock": "2.5.8",
    "jest-environment-jsdom": "30.5.2",
    "prettier": "3.10.1",
    "replace-in-file-webpack-plugin": "1.0.6",
    "style-loader": "4.0.0",
    "swc-loader": "0.2.7",
    "terser-webpack-plugin": "5.6.1",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "typescript-eslint": "8.73.0",
    "webpack": "5.113.0",
    "webpack-cli": "7.3.1",
    "webpack-livereload-plugin": "3.0.2",
    "webpack-subresource-integrity": "5.2.0-rc.1",
    "webpack-virtual-modules": "0.6.2"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/data": "13.3.1",
    "@grafana/plugin-ui": "0.18.0",
    "@grafana/runtime": "13.3.1",
    "@grafana/schema": "13.3.1",
    "@grafana/ui": "13.3.1",
    "lodash": "4.18.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "rxjs": "7.8.2",
    "semver": "7.8.6",
    "tslib": "2.9.1"
  },
  "packageManager": "yarn@4.18.1"
}
